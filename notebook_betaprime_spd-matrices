    "### scaling by matrix size\n",
    "from scipy.interpolate import BSpline, make_interp_spline\n",
    "from scipy.ndimage import gaussian_filter1d\n",
    "import time\n",
    "import pandas as pd\n",
    "\n",
    "num_samples=100\n",
    "num_sizes = 50\n",
    "low_size=1.5\n",
    "high_size=20\n",
    "sizes = [int(10*i) for i in np.linspace(low_size,high_size,num_sizes)]\n",
    "times = []\n",
    "\n",
    "for i, size in enumerate(sizes):\n",
    "    alpha=size \n",
    "    samples = gen_spd_sample(num_samples, size, loc=2, scale=1)\n",
    "    start_time = time.time()\n",
    "    mat = np.round(kernelmat(samples, alpha),2)\n",
    "    end_time = time.time()\n",
    "    times.append(np.round(end_time-start_time,2))\n",
    "    print(f'Size {i+1} / {num_sizes} done')\n",
    "\n",
    "#smooth via spline\n",
    "spl_num= 5\n",
    "spl_order=3\n",
    "spl = make_interp_spline(sizes, times, k=spl_order)\n",
    "sizes_new = [int(10*i) for i in np.linspace(low_size,high_size,spl_num)]\n",
    "smooth_spl = spl(sizes_new)\n",
    "\n",
    "#smooth via gaussian\n",
    "\n",
    "sizes_gau= sizes[1::2]\n",
    "times_gau = times[1::2]\n",
    "smooth_gau = gaussian_filter1d(times_gau, sigma=2)\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "\n",
    "ax.plot(sizes_gau, smooth_gau, color='orange')\n",
